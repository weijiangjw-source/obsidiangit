"smart_sources:clippings/真正好的教育，从来不是把孩子训练成没有反抗能力的人。.md": {"path":"clippings/真正好的教育，从来不是把孩子训练成没有反抗能力的人。.md","last_read":{"hash":"ogsge8","at":1782924050798},"class_name":"SmartSource","last_import":{"mtime":1782924028323,"size":3250,"at":1782924050755,"hash":"ogsge8"},"outlinks":[{"title":"Arnold Lee","target":"https://x.com/LWH050303666","line":11},{"title":"@LWH050303666","target":"https://x.com/LWH050303666","line":11}],"metadata":{"title":"Arnold Lee on X: \"@Morris_LT 很多家庭把“听话”当成优点，因为听话意味着好管、不惹事、不顶嘴、不制造麻烦。父母一句话，孩子就照做；长辈一个眼神，孩子就收回自己的想法。表面上看，这是懂事，实际上很多时候只是一个孩子过早学会了压抑自己。真正好的教育，从来不是把孩子训练成没有反抗能力的人。\"","source":"https://x.com/LWH050303666/status/2072174162052108430","author":null,"published":"2026-07-01","created":"2026-07-02","description":null,"tags":["#clippings"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"blocks_data":{"#---frontmatter---":{"text":null,"length":0,"last_read":{"hash":"rp2skx","at":1782924050790},"key":"clippings/真正好的教育，从来不是把孩子训练成没有反抗能力的人。.md#---frontmatter---","lines":[1,10],"size":325,"outlinks":[],"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":57,"read_hash":"rp2skx","at":1782924050790}}}},"#":{"text":null,"length":0,"last_read":{"hash":"1ei6140","at":1782924050798},"key":"clippings/真正好的教育，从来不是把孩子训练成没有反抗能力的人。.md#","lines":[11,13],"size":956,"outlinks":[{"title":"Arnold Lee","target":"https://x.com/LWH050303666","line":1},{"title":"@LWH050303666","target":"https://x.com/LWH050303666","line":1}],"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":58,"read_hash":"1ei6140","at":1782924050798}}}}},"key":"clippings/真正好的教育，从来不是把孩子训练成没有反抗能力的人。.md","block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"clippings/真正好的教育，从来不是把孩子训练成没有反抗能力的人。.md","requires_reimport":false},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":6,"read_hash":"ogsge8","at":1782924050757}}}},
