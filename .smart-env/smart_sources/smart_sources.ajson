"smart_sources:clippings/普通人如何成功？.md": {"path":"clippings/普通人如何成功？.md","last_read":{"hash":"1t3pjsv","at":1783440221672},"class_name":"SmartSource","last_import":{"mtime":1783440208668,"size":15868,"at":1783440212347,"hash":"1t3pjsv"},"outlinks":[{"title":"@TradercBTC","target":"@TradercBTC","line":5},{"title":"Image","target":"https://pbs.twimg.com/media/HMm-qvwaYAAPiKl?format=jpg&name=large","line":12,"embedded":true}],"metadata":{"title":"普通人如何成功？","source":"https://x.com/TradercBTC/status/2074398756536279141","author":["[[@TradercBTC]]"],"published":"2026-07-07","created":"2026-07-08","description":"2003年，一个叫霍华德·舒尔茨的人已经是星巴克的董事长。在此之前二十年，他是纽约布鲁克林公共住房项目里长大的穷孩子，靠橄榄球奖学金上了大学，毕业后在施乐公司卖文字处理机。他人生中的第一个转折点不是某个天才时刻，而是一次出差去米兰时走进了一家意式咖啡馆。他看到的东西——咖啡作为一...","tags":["#clippings"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"clippings/普通人如何成功？.md","blocks_data":{"#---frontmatter---":{"text":null,"length":0,"last_read":{"hash":"1xn4mwa","at":1783440215566},"key":"clippings/普通人如何成功？.md#---frontmatter---","lines":[1,11],"size":340,"outlinks":[{"title":"@TradercBTC","target":"@TradercBTC","line":5}],"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":20,"read_hash":"1xn4mwa","at":1783440215566}}}},"#":{"text":null,"length":0,"last_read":{"hash":"1bowror","at":1783440215581},"key":"clippings/普通人如何成功？.md#","lines":[12,202],"size":5407,"outlinks":[{"title":"Image","target":"https://pbs.twimg.com/media/HMm-qvwaYAAPiKl?format=jpg&name=large","line":1,"embedded":true}],"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":21,"read_hash":"1bowror","at":1783440215581}}}}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"clippings/普通人如何成功？.md","requires_reimport":false},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":4,"read_hash":"1t3pjsv","at":1783440221672}}}},
